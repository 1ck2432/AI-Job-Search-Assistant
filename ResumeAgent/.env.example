# ===========================================
# ResumeAgent 环境变量模板（脱敏示例）
# ===========================================
# 使用方法：复制本文件为 .env 并填入你的真实配置
#   Windows:     copy .env.example .env
#   macOS/Linux: cp .env.example .env
#
# 注意：.env 已被 .gitignore 忽略，不会提交到 Git，
#       请勿将真实 API Key 提交到仓库。

# ---------- LLM Provider 选型 ----------
# 可选值: ollama | openai | deepseek
LLM_PROVIDER=openai

# ---------- Ollama 本地模型配置 ----------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=bge-m3

# ---------- OpenAI 兼容 API 配置（通义千问/OpenAI 等） ----------
# 请替换为你的真实 API Key
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen3.7-plus

# ---------- DeepSeek API 配置 ----------
# 请替换为你的真实 API Key
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---------- HuggingFace 镜像（国内网络可选） ----------
# 可选值: https://hf-mirror.com（国内加速） | 留空则使用官方源
HF_ENDPOINT=https://hf-mirror.com

# ---------- Embedding 模型配置 ----------
# 默认使用 BGE-M3，可通过 Ollama 或 HuggingFace 加载
EMBED_MODEL_NAME=BAAI/bge-m3
EMBED_DEVICE=cpu

# ---------- Chroma 向量库配置 ----------
CHROMA_PERSIST_DIR=./vector_store/chroma_db
CHROMA_COLLECTION_NAME=resume_knowledge

# ---------- RAG 检索配置 ----------
RAG_TOP_K=5
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=128
# 混合检索权重：向量检索权重
RAG_HYBRID_VECTOR_WEIGHT=0.6
# CrossEncoder 重排模型
RERANK_MODEL_NAME=BAAI/bge-reranker-v2-m3

# ---------- SQLite 数据库配置 ----------
SQLITE_DB_PATH=./database/resume_agent.db

# ---------- 日志配置 ----------
LOG_LEVEL=INFO
LOG_DIR=./logs
LOG_RETENTION=7 days
LOG_FORMAT={time:YYYY-MM-DD HH:mm:ss} | {level} | {name}:{function}:{line} | {message}

# ---------- Gradio 前端配置 ----------
GRADIO_SERVER_HOST=127.0.0.1
GRADIO_SERVER_PORT=7860
GRADIO_TITLE=ResumeAgent - 求职简历智能多Agent协同系统
GRADIO_THEME=soft

# ---------- 文件上传配置 ----------
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
